{
  "headers": [
    { "source": "/feed/posts/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/feed/index.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/feed/release.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ],
  "redirects": [
    {"source":"/politica-de-privacidade.html","destination":"/privacidade","permanent":true},
    {"source":"/site/pages/player-audio","destination":"/ouvir","permanent":true},
    {"source":"/site/pages/player-audio/","destination":"/ouvir","permanent":true},
    {"source":"/site/pages/player-video","destination":"/assistir","permanent":true},
    {"source":"/site/pages/player-video/","destination":"/assistir","permanent":true},
    {
      "source": "/debates",
      "destination": "/conteudos?categoria=debate-88",
      "permanent": true
    },
    {
      "source": "/site/pages/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/site/pages/home/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/site/pages/home/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {"source":"/:legacy(.*\\.php)","destination":"/api/legacy-gone"},
    { "source": "/enquetes/:slug", "destination": "/index.html" },
    { "source": "/conteudos", "destination": "/conteudos/index.html" },
    { "source": "/nossa-radio", "destination": "/nossa-radio/index.html" },
    { "source": "/equipe", "destination": "/equipe/index.html" },
    { "source": "/programacao", "destination": "/programacao/index.html" },
    { "source": "/anuncie", "destination": "/anuncie/index.html" },
    { "source": "/ouvir", "destination": "/ouvir/index.html" },
    { "source": "/assistir", "destination": "/assistir/index.html" },
    { "source": "/privacidade", "destination": "/privacidade/index.html" }
  ]
}
